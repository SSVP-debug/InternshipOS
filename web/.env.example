# Copy this file to .env.local and fill in your own project's values.
#
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: the SAME Supabase project the
# api/ backend is configured against (see api/.env.example). The frontend
# uses supabase-js only for authentication (sign up / sign in / sign out) —
# it never talks to Postgres or Supabase's REST API directly. Every piece of
# actual application data (opportunities, applications, claims, etc.) goes
# through the Express API below, using the access_token this client obtains.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the api/ Express server (see api/README or api/.env.example).
# No trailing slash.
VITE_API_BASE_URL=http://localhost:3000
