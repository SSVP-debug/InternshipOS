{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // "." (not "scripts") because scripts/ingest.ts imports from
    // src/lib/ingestion — unlike smoke-prod.ts and check-orphan-claims.ts,
    // which are self-contained and never imported src/. Widened only as
    // far as necessary for that one real import, not as a general policy
    // change for future scripts.
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["scripts", "src"]
}
