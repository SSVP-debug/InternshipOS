{
  "name": "internshipos-api",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 0 / Day 1 — minimal signup + profile creation API for InternshipOS.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "smoke:prod": "tsx scripts/smoke-prod.ts",
    "ingest": "tsx scripts/ingest.ts",
    "match": "tsx scripts/run-matching.ts",
    "match:all": "tsx scripts/match-all.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11"
  }
}
