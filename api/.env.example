# Copy to .env and fill in from your Supabase project settings
# (Project Settings -> API). Never commit the real .env file.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # server-side only, never expose to a client
PORT=3000
CONSENT_POLICY_VERSION=v1.0

# ── Engineering-foundation config (optional, all have safe defaults) ────
# NODE_ENV controls log formatting only (pretty in dev, JSON in
# production) — never gates which secrets are read; every var above is
# always required, in every environment, with no environment-specific
# fallback value.
NODE_ENV=development

# Comma-separated browser origins allowed to call this API cross-origin,
# e.g. https://app.internshipos.example,https://staging.internshipos.example
# Leave unset to keep the API unreachable from any browser page (curl /
# server-to-server calls are unaffected — CORS is a browser-side check).
# ALLOWED_ORIGINS=

# Ceiling for POST /signup (the one unauthenticated route) per IP per
# RATE_LIMIT_WINDOW_MINUTES. Defaults shown.
# SIGNUP_RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MINUTES=15

# Overrides the default pino log level ("info" in production, "debug"
# otherwise). Set to "silent" to suppress logs entirely (used by
# vitest.config.ts during the test suite).
# LOG_LEVEL=info

# ── npm run smoke:prod (api/scripts/smoke-prod.ts) ──────────────────────
# Uses SUPABASE_URL + SUPABASE_ANON_KEY above (never SUPABASE_SERVICE_ROLE_KEY —
# the smoke test authenticates as a real disposable candidate, same as any
# other client). Set these as real environment variables when running the
# smoke test — do not put real production values in a committed .env file.
#
# SMOKE_API_URL=https://internshipos-api.onrender.com   # defaults to this if unset
# SMOKE_PROD_CONFIRM=true   # required — explicit confirmation the target is production
# SMOKE_TEST_MODE=true      # only for developing the smoke script itself against a local stack

# ── npm run check:orphan-claims (api/scripts/check-orphan-claims.ts) ────
# Uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above. Read-only,
# cross-candidate integrity check — see the script's header comment.

