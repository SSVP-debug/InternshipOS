# Copy to .env and fill in from your Supabase project settings
# (Project Settings -> API). Never commit the real .env file.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # server-side only, never expose to a client
PORT=3000
CONSENT_POLICY_VERSION=v1.0

# ── npm run smoke:prod (api/scripts/smoke-prod.ts) ──────────────────────
# Uses SUPABASE_URL + SUPABASE_ANON_KEY above (never SUPABASE_SERVICE_ROLE_KEY —
# the smoke test authenticates as a real disposable candidate, same as any
# other client). Set these as real environment variables when running the
# smoke test — do not put real production values in a committed .env file.
#
# SMOKE_API_URL=https://internshipos-api.onrender.com   # defaults to this if unset
# SMOKE_PROD_CONFIRM=true   # required — explicit confirmation the target is production
# SMOKE_TEST_MODE=true      # only for developing the smoke script itself against a local stack
