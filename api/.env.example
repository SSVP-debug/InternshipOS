# Copy to .env and fill in from your Supabase project settings
# (Project Settings -> API). Never commit the real .env file.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # server-side only, never expose to a client
PORT=3000
CONSENT_POLICY_VERSION=v1.0
